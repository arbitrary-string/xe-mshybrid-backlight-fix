 			    connector->base.base.id, connector->base.name);
@@ -754,3 +799,85 @@
 
 	return -ENODEV;
 }
+
+/*
+ * MSHYBRID_LUMINANCE_REASSERT: confirmed live 2026-10-26 that this exact
+ * panel's DPCD 0x721 luminance-control-enable bit gets cleared by *something*
+ * during/after a suspend/resume cycle -- xe's own enable_backlight() path
+ * already correctly re-writes it (confirmed via drm.debug: the right value
+ * lands at 0x721 multiple times during a real resume), but the panel still
+ * ends up unresponsive afterward, meaning the clear happens *after* those
+ * writes, outside anything xe's own atomic-commit machinery re-triggers on
+ * its own. This mirrors a bug already found and fixed once before, on the
+ * dGPU-mode NVIDIA-RM-API path for this identical panel/bit
+ * (clevo-control-panel's oled_luminance_daemon.py, SAFETY_REASSERT_SECONDS):
+ * "DPCD 0x721's luminance-mode-enable bit gets reset as a side effect of
+ * *any* Mutter display mode-set" -- not confined to one catchable trigger,
+ * so a periodic, idempotent reassert is what actually worked there, not
+ * trying to enumerate every cause. xe has no public interface for a cheap,
+ * targeted single-register DPCD write the way NVIDIA's RM API gives
+ * userspace (confirmed: no raw AUX debugfs path exists here beyond the much
+ * heavier i915_dp_force_link_retrain, which forces a full link retrain).
+ * This debugfs entry exists to let a small userspace reassert service do
+ * the same minimal, idempotent read-then-write oled_luminance.py's own
+ * enable_luminance_mode() does, without needing a full link retrain or
+ * driver reload: read the mode-set register, write it back with the
+ * luminance-enable bit added only if it isn't already set. A no-op, safe to
+ * poll frequently, on any connector that isn't actually using luminance mode
+ * at all (panel->backlight.edp.vesa.info.luminance_set false).
+ */
+static int mshybrid_luminance_reassert_show(void *data, u64 *val)
+{
+	struct intel_connector *connector = to_intel_connector(data);
+	struct intel_panel *panel = &connector->panel;
+
+	*val = panel->backlight.edp.vesa.info.luminance_set;
+
+	return 0;
+}
+
+static int mshybrid_luminance_reassert_write(void *data, u64 val)
+{
+	struct intel_connector *connector = to_intel_connector(data);
+	struct intel_display *display = to_intel_display(connector);
+	struct intel_dp *intel_dp = intel_attached_dp(connector);
+	struct intel_panel *panel = &connector->panel;
+	u8 mode = 0;
+	int ret;
+
+	if (!panel->backlight.edp.vesa.info.luminance_set)
+		return -ENODEV;
+
+	mutex_lock(&display->backlight.lock);
+
+	ret = drm_dp_dpcd_read_byte(&intel_dp->aux, DP_EDP_BACKLIGHT_MODE_SET_REGISTER, &mode);
+	if (ret < 0)
+		goto out;
+
+	if (!(mode & DP_EDP_PANEL_LUMINANCE_CONTROL_ENABLE))
+		ret = drm_dp_dpcd_write_byte(&intel_dp->aux, DP_EDP_BACKLIGHT_MODE_SET_REGISTER,
+					      mode | DP_EDP_PANEL_LUMINANCE_CONTROL_ENABLE);
+
+out:
+	mutex_unlock(&display->backlight.lock);
+
+	drm_dbg_kms(display->drm,
+		    "[CONNECTOR:%d:%s] MSHYBRID_LUMINANCE_REASSERT: mode=0x%02x ret=%d\n",
+		    connector->base.base.id, connector->base.name, mode, ret);
+
+	return ret < 0 ? ret : 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(mshybrid_luminance_reassert_fops,
+			 mshybrid_luminance_reassert_show,
+			 mshybrid_luminance_reassert_write, "%llu\n");
+
+void intel_dp_aux_backlight_debugfs_add(struct intel_connector *connector)
+{
+	struct dentry *root = connector->base.debugfs_entry;
+
+	if (connector->base.connector_type != DRM_MODE_CONNECTOR_eDP)
+		return;
+
+	debugfs_create_file("mshybrid_luminance_reassert", 0644, root,
+			    connector, &mshybrid_luminance_reassert_fops);
+}
