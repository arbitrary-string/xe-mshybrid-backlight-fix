 			panel->backlight.level = current_level;
 			panel->backlight.enabled = panel->backlight.level != 0;
 		} else {
+			/*
+			 * Firmware leaves this panel's TCON in legacy PWM
+			 * mode at boot, not DPCD mode -- normally
+			 * intel_dp_aux_vesa_enable_backlight() (which writes
+			 * BACKLIGHT_MODE_SET_REGISTER to actually switch the
+			 * TCON into DPCD mode) fixes this, but atomic state
+			 * readout at boot sees the encoder already enabled
+			 * (inherited from the firmware-lit panel) and skips
+			 * calling it -- confirmed live: brightness control
+			 * silently does nothing until the next full
+			 * enable cycle (e.g. a suspend/resume), which isn't
+			 * skippable and always calls it. Do the same AUX
+			 * mode-switch + initial level write right here
+			 * instead, since setup (unlike enable) always runs
+			 * at boot regardless of that optimization.
+			 */
 			panel->backlight.level = panel->backlight.max;
 			panel->backlight.enabled = false;
+			drm_edp_backlight_enable(&intel_dp->aux,
+						  &panel->backlight.edp.vesa.info,
+						  panel->backlight.level);
+			panel->backlight.enabled = true;
 		}
 	} else {
 		panel->backlight.max = panel->backlight.pwm_level_max;
