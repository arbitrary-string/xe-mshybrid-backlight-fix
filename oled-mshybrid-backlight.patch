# MSHybrid OLED backlight patch for xe (Panther Lake iGPU), board L55xJNP.
#
# Four pieces:
#  1. #include "intel_pps.h" -- needed by nothing in this version of the
#     patch anymore, kept because the build is known-good with it; harmless.
#  2. intel_dp_aux_vesa_enable_backlight(): MSHYBRID_BACKLIGHT_ENABLE_PROBE
#     diagnostic logging only, no behavior change. Added 2026-10-23 to
#     find out whether this function -- the real per-enable-cycle
#     backlight callback -- is even reached on a boot where brightness
#     ends up broken, and whether drm_edp_backlight_enable() succeeds,
#     since neither of those facts were visible in dmesg before this.
#  3. intel_dp_aux_vesa_setup_backlight(): the original, minimal fix from
#     2026-09-11 -- confirmed working across many boots of kernel
#     7.0.0-34-generic -- unmodified. Firmware leaves this panel's TCON in
#     legacy PWM mode at boot, not DPCD mode; intel_dp_aux_vesa_enable_backlight()
#     (which writes BACKLIGHT_MODE_SET_REGISTER to actually switch the TCON
#     into DPCD mode) normally fixes this, but atomic state readout at boot
#     can see the encoder already enabled (inherited from the firmware-lit
#     panel) and skip calling it. Do the same AUX mode-switch + initial
#     level write right here instead, since setup (unlike enable) always
#     runs at boot regardless of that optimization.
#  4. intel_dp_aux_supports_vesa_backlight(): MSHYBRID_LUMINANCE_CAP_RELAX
#     -- the actual fix for the 2026-10-23 saga (see git log for the full,
#     warts-and-all history of everything tried and reverted before this).
#     Direct, hard evidence chain: (a) confirmed live via drm.debug that
#     xe's AUX writes to BACKLIGHT_MODE_SET_REGISTER (0x721) succeed with
#     correct values on every boot, broken or working, byte-for-byte
#     identical whether a real suspend/resume follows or not -- the panel
#     only actually responds after the real suspend/resume, proving xe's
#     normal AUX write path was never the broken piece; (b) this project's
#     own already-proven, already-shipped dGPU-mode fix
#     (clevo-control-panel's oled_luminance.py) documents, for this exact
#     panel: "DPCD 0x721 bit 7 (the luminance control enable flag) reads 0
#     by default. Setting that single bit... immediately unlocked real
#     full-range brightness on this exact panel, live-verified" -- using
#     NVIDIA's RM API directly, bypassing xe entirely, in dGPU mode; (c)
#     upstream drm_edp_backlight_enable() already has the exact mechanism
#     to set that same bit (DP_EDP_PANEL_LUMINANCE_CONTROL_ENABLE), gated
#     behind a `bl->luminance_set` flag xe's own code decides, not a live
#     capability probe; (d) xe's own gate for that decision
#     (intel_dp_aux_supports_vesa_backlight()) requires BOTH
#     DP_EDP_PANEL_LUMINANCE_CONTROL_CAPABLE and
#     DP_EDP_SMOOTH_BRIGHTNESS_CAPABLE, while oled_luminance.py's
#     already-proven check only ever required the first one -- and xe's
#     own dmesg on this exact panel has only ever logged the *other*
#     branch's "AUX Backlight Control Supported!" message, never "AUX
#     Luminance Based Backlight Control Supported!", meaning the stricter
#     combined check fails here despite the panel demonstrably supporting
#     luminance control. Relaxed to match the simpler, already-proven
#     check -- untested as of this commit, first real boot pending.
--- a/drivers/gpu/drm/i915/display/intel_dp_aux_backlight.c
+++ b/drivers/gpu/drm/i915/display/intel_dp_aux_backlight.c
@@ -40,6 +40,7 @@
 #include "intel_display_core.h"
 #include "intel_display_types.h"
 #include "intel_dp.h"
+#include "intel_pps.h"
 #include "intel_dp_aux_backlight.h"

 /*
@@ -495,6 +496,27 @@
 	struct intel_connector *connector = to_intel_connector(conn_state->connector);
 	struct intel_panel *panel = &connector->panel;
 	struct intel_dp *intel_dp = enc_to_intel_dp(connector->encoder);
+	struct intel_display *display = to_intel_display(connector);
+	int ret;
+
+	/*
+	 * MSHYBRID_BACKLIGHT_ENABLE_PROBE: diagnostic only, no behavior
+	 * change. Confirmed live (2026-10-23) that on a boot where
+	 * brightness ends up broken, this real enable() callback runs
+	 * (same pipe-enable cycle, same link retrain, same
+	 * intel_backlight_enable() call as a boot where it works) but the
+	 * resulting DPCD writes (0x721/0x722/0x724/0x728) never show up in
+	 * dmesg -- yet drm_edp_backlight_enable() below has no gating
+	 * logic at all and this function has no logging of its own, so
+	 * there was no way to tell whether it was even reached, or what it
+	 * saw, without adding this.
+	 */
+	drm_dbg_kms(display->drm,
+		    "[CONNECTOR:%d:%s] MSHYBRID_BACKLIGHT_ENABLE_PROBE: level=%u aux_set=%d aux_enable=%d luminance_set=%d\n",
+		    connector->base.base.id, connector->base.name, level,
+		    panel->backlight.edp.vesa.info.aux_set,
+		    panel->backlight.edp.vesa.info.aux_enable,
+		    panel->backlight.edp.vesa.info.luminance_set);

 	if (!(panel->backlight.edp.vesa.info.aux_enable ||
 	      panel->backlight.edp.vesa.info.luminance_set)) {
@@ -509,7 +531,10 @@
 		panel->backlight.pwm_funcs->enable(crtc_state, conn_state, pwm_level);
 	}

-	drm_edp_backlight_enable(&intel_dp->aux, &panel->backlight.edp.vesa.info, level);
+	ret = drm_edp_backlight_enable(&intel_dp->aux, &panel->backlight.edp.vesa.info, level);
+	drm_dbg_kms(display->drm,
+		    "[CONNECTOR:%d:%s] MSHYBRID_BACKLIGHT_ENABLE_PROBE: drm_edp_backlight_enable returned %d\n",
+		    connector->base.base.id, connector->base.name, ret);
 }

 static void intel_dp_aux_vesa_disable_backlight(const struct drm_connector_state *old_conn_state,
@@ -588,6 +613,10 @@
 		} else {
 			panel->backlight.level = panel->backlight.max;
 			panel->backlight.enabled = false;
+			drm_edp_backlight_enable(&intel_dp->aux,
+						  &panel->backlight.edp.vesa.info,
+						  panel->backlight.level);
+			panel->backlight.enabled = true;
 		}
 	} else {
 		panel->backlight.max = panel->backlight.pwm_level_max;
@@ -644,8 +673,22 @@
 	struct intel_dp *intel_dp = intel_attached_dp(connector);
 	struct intel_panel *panel = &connector->panel;

-	if ((intel_dp->edp_dpcd[3] & DP_EDP_PANEL_LUMINANCE_CONTROL_CAPABLE) &&
-	    (intel_dp->edp_dpcd[3] & DP_EDP_SMOOTH_BRIGHTNESS_CAPABLE)) {
+	/*
+	 * MSHYBRID_LUMINANCE_CAP_RELAX: upstream requires both
+	 * DP_EDP_PANEL_LUMINANCE_CONTROL_CAPABLE and
+	 * DP_EDP_SMOOTH_BRIGHTNESS_CAPABLE before even attempting luminance
+	 * mode. This panel's own userspace-proven fix
+	 * (clevo-control-panel's oled_luminance.py, confirmed live via the
+	 * NVIDIA RM API in dGPU mode: "Setting that single bit... immediately
+	 * unlocked real full-range brightness on this exact panel") only
+	 * ever checks DP_EDP_PANEL_LUMINANCE_CONTROL_CAPABLE -- and xe's own
+	 * dmesg here has only ever logged the *other* branch's "AUX Backlight
+	 * Control Supported!" message, never this one, meaning the combined
+	 * && check fails on this panel despite it demonstrably supporting
+	 * luminance control. Relaxed to match the simpler, already-proven
+	 * check.
+	 */
+	if (intel_dp->edp_dpcd[3] & DP_EDP_PANEL_LUMINANCE_CONTROL_CAPABLE) {
 		drm_dbg_kms(display->drm,
 			    "[CONNECTOR:%d:%s] AUX Luminance Based Backlight Control Supported!\n",
 			    connector->base.base.id, connector->base.name);
